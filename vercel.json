{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node deploy/vercel-build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "echo 'no dependencies to install'",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
